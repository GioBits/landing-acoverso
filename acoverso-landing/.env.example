# Copia estas variables en Vercel > Project > Settings > Environment Variables
# Token personal de Airtable con data.records:read y data.records:write sobre la base
AIRTABLE_TOKEN=
# ID de la base, p. ej. appXXXXXXXXXXXXXX
AIRTABLE_BASE=
# Nombre o ID de la tabla
AIRTABLE_TABLE=ACEPTACIONES
# Dominio público; si se deja vacío se acepta el mismo dominio que sirve la página
ALLOWED_ORIGIN=https://acoverso.com
# Secreto configurado en el webhook de Cal.com (Settings > Developer > Webhooks)
CAL_WEBHOOK_SECRET=
